{
  "name": "vendor/new-php-project",
  "description": "Starter PHP project skeleton",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "php -S localhost:8000 -t public public/router.php",
    "test": "phpunit"
  }
}
